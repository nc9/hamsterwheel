{
  "name": "@hamsterwheel/sandbox",
  "version": "0.1.1",
  "description": "OS-isolated docker session runner for headless agent sessions.",
  "homepage": "https://github.com/nc9/hamsterwheel#readme",
  "bugs": {
    "url": "https://github.com/nc9/hamsterwheel/issues"
  },
  "license": "MIT",
  "author": "Nik Cubrilovic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nc9/hamsterwheel.git",
    "directory": "packages/sandbox"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "build": "bun ../../scripts/build.ts",
    "prepublishOnly": "bun ../../scripts/build.ts"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
